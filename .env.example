# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_USER_ID=your_admin_user_id_here

# AI Configuration (Azure AI Foundry, OpenAI-compatible endpoint)
# If unset, the bot falls back to static content from the database
AZURE_AI_ENDPOINT=https://your-project.services.ai.azure.com/openai/v1
AZURE_AI_DEPLOYMENT=your_deployment_name
AZURE_AI_API_KEY=your_api_key_here

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json (for containers/production) or text (for development)
# Auto-detected: json in containers, text in development
# LOG_FORMAT=json

# Log file path (empty to disable file logging)
# In container mode, file logging is disabled by default
# LOG_FILE=motivator_bot.log

# Container environment flag (set to 'true' when running in Docker)
# Auto-detected based on .dockerenv or Kubernetes environment
# CONTAINER_ENV=true
